# IPF3 reverse proxy. Rendered by install-server.sh (placeholders: __DOMAIN__,
# __CERT__, __KEY__). Static UI is served by nginx; /api goes to uvicorn.

limit_req_zone $binary_remote_addr zone=ipf3_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=ipf3_api:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ipf3_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ipf3_tls:10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 4m;

    # Note: nginx drops inherited add_header directives in any location that
    # declares its own, so every such location re-includes this snippet.
    include /etc/nginx/snippets/ipf3-headers.conf;

    root /opt/ipf3/web;
    index index.html;

    location = /api/v1/auth/login {
        limit_req zone=ipf3_auth burst=5 nodelay;
        include /etc/nginx/snippets/ipf3-proxy.conf;
    }
    location = /api/agent/v1/enroll {
        limit_req zone=ipf3_auth burst=5 nodelay;
        include /etc/nginx/snippets/ipf3-proxy.conf;
    }
    location = /api/v1/ws/live {
        include /etc/nginx/snippets/ipf3-proxy.conf;
        proxy_read_timeout 3600s;
    }
    location = /api/agent/v1/jobs {
        # Agents long-poll for up to 25 s.
        include /etc/nginx/snippets/ipf3-proxy.conf;
        proxy_read_timeout 60s;
    }
    location /api/ {
        limit_req zone=ipf3_api burst=100 nodelay;
        include /etc/nginx/snippets/ipf3-proxy.conf;
    }
    location = /healthz { include /etc/nginx/snippets/ipf3-proxy.conf; }
    # VPN subscription links (public, token protected, rate limited).
    location /sub/ {
        limit_req zone=ipf3_api burst=20 nodelay;
        include /etc/nginx/snippets/ipf3-proxy.conf;
    }

    location /assets/ {
        expires 1y;
        include /etc/nginx/snippets/ipf3-headers.conf;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/snippets/ipf3-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
